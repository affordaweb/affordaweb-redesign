# ── Vercel KV ────────────────────────────────────────────────────────────────
# Set up at: https://vercel.com/docs/storage/vercel-kv
KV_URL=your_kv_url_here
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here
KV_REST_API_READ_ONLY_TOKEN=your_kv_read_only_token_here

# ── Resend (email) ────────────────────────────────────────────────────────────
# Get your API key at: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Email addresses ───────────────────────────────────────────────────────────
ADMIN_EMAIL=hello@affordawebsolutions.com
FROM_EMAIL=SEO Audit <audits@affordawebsolutions.com>

# ── Site URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://affordawebsolutions.com

# ── Web3Forms (contact form) ───────────────────────────────────────────────────
# Get your key at: https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here
